# Secrets — never commit real .env files
.env
*.env

# Nginx Proxy Manager data
home-server/nginx-proxy-manager/data/
home-server/nginx-proxy-manager/letsencrypt/

# Pi-hole runtime data
home-server/pihole/pihole/gravity_backups/
home-server/pihole/pihole/listsCache/
home-server/pihole/pihole/config_backups/
home-server/pihole/pihole/migration_backup/
home-server/pihole/pihole/hosts/
home-server/pihole/pihole/dhcp.leases
home-server/pihole/pihole/cli_pw
home-server/pihole/pihole/versions
home-server/pihole/pihole/gravity.db
home-server/pihole/pihole/gravity_old.db
home-server/pihole/pihole/pihole-FTL.db*
home-server/pihole/pihole/pihole.toml.lock
home-server/pihole/pihole/logrotate

# Vaultwarden data
home-server/vw-data/

# Wireguard peer keys & runtime
home-server/wireguard/

# Aiostreams app data (not config); keep only the variable template.
home-server/aiostreams/*
!home-server/aiostreams/.env.example

# StremThru runtime data (SQLite cache, rebuilt on start)
home-server/stremthru/

# TeslaMate
teslamate/mosquitto-teslamate/mosquitto-data/
teslamate/import/
teslamate/teslamate_backup.sql
teslamate/Teslamate-CustomGrafanaDashboards/

# UGOS torrent-client app folder: local runtime config, never in git
qbittorrent/

# Common postgres volume (managed by docker)
common/postgres-data/

# Minecraft Server
minecraft/modpacks
minecraft/data

# Frigate — the old `/frigate/config/` was root-anchored and never matched anything.
# Whitelist: ignore the whole config dir, keep only the hand-written config.
# Uses `/*` (contents) not `/` (the dir itself), otherwise the negation can't re-include.
# Everything else there is runtime state or secrets: frigate.db{,-shm,-wal}, backup.db,
# .jwt_secret, .exports, .timeline, .vacuum, model_cache/, go2rtc_homekit.yml (pairing keys).
home-server/frigate/config/*
!home-server/frigate/config/config.yaml

# General
*.log
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.miss
tmp/

teslamate-backup.sql

*.cache
# Maison
maison/data/
maison/.scratch/
# Maison — données personnelles (critères, adresses, annonces réelles)
maison/config/criteria.yaml
maison/tests/fixtures/

# OpenSpec tool integrations generated under home-server/ (skills and commands
# for each agent). The OpenSpec root is openspec/ at the repo root.
home-server/.agents/
home-server/.claude/
home-server/.gemini/
home-server/.hermes/

# Ansible / Terraform: vault password, provider cache, state, variable files
ansible/.vault-pass*
ansible/.venv/
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
!*.example.tfvars

# OS / Python noise
.DS_Store
__pycache__/

# aiometadata runtime data (its *.cache files are covered by *.cache above)
home-server/aiometadata/data/imdb-ratings.bin
