# Copier en .env (chmod 600). Ne jamais commiter le .env.

# Espace client Orange (Internet + Mobile sur le même compte)
ORANGE_USERNAME=
ORANGE_PASSWORD=
# Nombre de factures Orange attendues chaque mois (2 = Internet + Mobile)
ORANGE_EXPECTED_INVOICES=2

# Quote-part EURL des factures Orange, en fraction du TTC (ex. 0.80 pour 80 %)
ORANGE_SHARE=
# Forfaits mensuels sans facture (prorata des échéanciers annuels), en euros, TVA non déduite
GAS_MONTHLY_EUR=
ELECTRICITY_MONTHLY_EUR=

# Jour du mois M où le loyer de M-1 est réglé (date de paiement de la quittance)
RENT_PAYMENT_DAY=6

# Webhook Discord (même salon que le stack maison)
DISCORD_WEBHOOK_URL=

# Dossier EURL synchronisé (CLOUD_NAS/05-Travail/<dossier de l'EURL>), contient Loyer/ et Charges/
EURL_CLOUD_DIR=/volume2/NAS-STORAGE/CLOUD_NAS/05-Travail/EURL-Nom-De-La-Societe
