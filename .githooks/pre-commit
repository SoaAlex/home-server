#!/bin/sh
# pre-commit: block a commit whose staged changes contain a secret.
#
#   1. secret-guard.py: no staged file is a secret carrier by name (.env files,
#      Terraform state, key stores, vault password files; templates such as
#      .env.example pass), and no staged content holds the value of a secret from a
#      .env file. Catches secrets that have no recognizable shape. It also copies the
#      staged files into a temporary directory for gitleaks, and a second time, with a
#      newline in front and under a name gitleaks reads, those it would skip: by name
#      (lock files, images, vendored directories...), by what the file begins with (a
#      SQLite database, an executable, an archive, a PDF, a text file that starts with
#      "MZ"), and those in UTF-16 or UTF-32. It asks gitleaks what it skips; a gitleaks
#      that does not report a token it is given refuses the commit.
#   2. gitleaks scan of that directory, configured by .gitleaks.toml. Findings are
#      printed redacted. gitleaks reads the files themselves and not `git diff
#      --staged`, which a git setting (colors, attributes, a diff driver) or a file
#      that git takes for binary can leave empty without any error. A staged file is
#      scanned whole, not only its added lines. A finding in _scan/<id>.txt is in a copy
#      of a staged file, and the list printed after the findings says which one.
#   3. Ansible Vault files must be encrypted
#      (ansible/scripts/check-vault-encrypted.sh).
#
# Every check runs, then the commit is refused if any failed. A missing python3 or
# gitleaks refuses the commit too: an unchecked commit is not a clean one.
#
# False positive: put `gitleaks:allow` in a comment on the line (checks 1 and 2 both
# honor it; `secret-guard:allow` works for check 1 only), or add the finding's
# fingerprint (file:rule:line, printed by gitleaks) to .gitleaksignore. `git commit
# --no-verify` skips this hook; the repository is public, so do not use it without
# the owner's approval. pre-push runs the same checks again on everything a push
# would send.
set -eu

hooks_dir=$(cd "$(dirname "$0")" && pwd)
. "$hooks_dir/lib.sh"
root=$(git rev-parse --show-toplevel)
cd "$root"
status=0
export_dir=
trap 'if [ -n "$export_dir" ]; then rm -rf "$export_dir"; fi' EXIT
exit_on_signals

python=$(find_python) || python=
gitleaks=$(find_gitleaks) || gitleaks=
config=$(find_gitleaks_config "$root" "$hooks_dir") || config=

if [ -z "$python" ]; then
  echo "pre-commit: python3 not found, so file names and .env values cannot be checked." >&2
  status=1
fi
if [ -z "$gitleaks" ]; then
  {
    echo "pre-commit: gitleaks not found, so the staged changes cannot be scanned."
    echo "Install it (macOS: brew install gitleaks; NAS: see README.md, Git hooks),"
    echo "or point GITLEAKS_BIN at the binary."
  } >&2
  status=1
elif [ -z "$config" ]; then
  echo "pre-commit: warning: .gitleaks.toml not found, using gitleaks' built-in rules only." >&2
fi

# --- 1. file names and .env values, and the copies for gitleaks ---------------
if [ -n "$python" ]; then
  if [ -n "$gitleaks" ]; then
    export_dir=$(mktemp -d "${TMPDIR:-/tmp}/pre-commit.XXXXXX")
  fi
  if ! run_secret_guard --staged; then
    status=1
  fi
fi

# --- 2. gitleaks scan of the copies -----------------------------------------
if [ -n "$export_dir" ] && export_has_files "$export_dir"; then
  rc=0
  gitleaks_scan_dir "$export_dir" || rc=$?
  if [ "$rc" -ne 0 ]; then
    {
      echo
      echo "pre-commit: gitleaks reported a problem (exit $rc)."
      echo "Real secret: remove it from the staged change, and rotate it if it ever left this machine."
      echo "False positive: add 'gitleaks:allow' in a comment on the line, or its Fingerprint"
      echo "(shown above) to .gitleaksignore."
    } >&2
    status=1
  fi
fi

# --- 3. Ansible Vault files must be encrypted -------------------------------
vault_check="$root/ansible/scripts/check-vault-encrypted.sh"
if [ -f "$vault_check" ]; then
  if ! bash "$vault_check" --staged >/dev/null; then
    status=1
  fi
else
  echo "pre-commit: warning: ansible/scripts/check-vault-encrypted.sh not found, vault files not checked." >&2
fi

if [ "$status" -ne 0 ]; then
  echo "pre-commit: commit refused." >&2
fi
exit "$status"
