#!/bin/sh
# commit-msg: the message must not hold a secret (commit messages are public too) and its
# subject must be a Conventional Commits 1.0.0 subject.
#
#   <type>[(<scope>)][!]: <description>
#
#   types, lowercase: feat fix docs style refactor perf test build ci chore revert
#
# Exempt from the format (still scanned for secrets): merge commits ("Merge ..."),
# git revert ('Revert "..."'), git's re-apply of a revert ('Reapply "..."') and
# autosquash markers ("fixup! ", "squash! ", "amend! "). `git commit --no-verify`
# skips this hook.
#
# It is a commit-msg hook, not a pre-commit one: git only has the message once the
# commit is being created. The scan runs first and the format check after it, so a
# secret typed into a badly formatted subject is refused without being printed back.
# The text logic lives in msgcheck.py: the same code on every awk and sed.
set -eu

msg_file=${1:?usage: commit-msg <message-file>}
hooks_dir=$(cd "$(dirname "$0")" && pwd)
. "$hooks_dir/lib.sh"

python=$(find_python) || python=
if [ -z "$python" ]; then
  echo "commit-msg: python3 not found, so the message cannot be checked." >&2
  exit 1
fi
gitleaks=$(find_gitleaks) || gitleaks=
tmp=$(mktemp "${TMPDIR:-/tmp}/commit-msg.XXXXXX")
trap 'rm -f "$tmp"' EXIT
status=0

# --- secrets in the message ---------------------------------------------------
# The text git will keep (comment lines included), minus the diff `git commit -v` appends.
if ! "$python" -I "$hooks_dir/msgcheck.py" extract "$msg_file" >"$tmp"; then
  echo "commit-msg: cannot read the message." >&2
  exit 1
fi

if ! "$python" -I "$hooks_dir/secret-guard.py" --message "$tmp"; then
  status=1
fi

if [ -z "$gitleaks" ]; then
  echo "commit-msg: gitleaks not found, so the message cannot be checked for secrets." >&2
  status=1
else
  root=$(git rev-parse --show-toplevel)
  config=$(find_gitleaks_config "$root" "$hooks_dir") || config=
  rc=0
  if [ -n "$config" ]; then
    "$gitleaks" stdin --redact --verbose --no-banner --no-color \
      --log-level warn --config "$config" <"$tmp" || rc=$?
  else
    "$gitleaks" stdin --redact --verbose --no-banner --no-color \
      --log-level warn <"$tmp" || rc=$?
  fi
  if [ "$rc" -ne 0 ]; then
    echo "commit-msg: gitleaks found a secret in the message (exit $rc); the commit is refused." >&2
    status=1
  fi
fi

# --- the subject --------------------------------------------------------------
if [ "$status" -eq 0 ]; then
  "$python" -I "$hooks_dir/msgcheck.py" check "$msg_file" || status=1
else
  "$python" -I "$hooks_dir/msgcheck.py" check "$msg_file" --no-echo || status=1
fi
exit "$status"
