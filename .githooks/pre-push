#!/bin/sh
# pre-push: refuse to push commits that carry a secret.
#
# pre-commit and commit-msg only see the commits made here with the hooks on. A merge, a
# rebase, a cherry-pick, `git am` and `git commit --no-verify` skip them, so this is the last
# gate before the commits become public. It runs the pre-commit checks on everything the push
# would send, i.e. the commits the remote does not have yet:
#
#   1. secret-guard.py --range: file names, .env values and commit messages. It also copies
#      every file the commits add or change (each version of it, under the id of its blob)
#      into a temporary directory, with a second copy of those gitleaks would skip by name
#      or cannot read (see pre-commit).
#   2. gitleaks over that directory, and over the commit messages, configured by
#      .gitleaks.toml; the message of an annotated tag is checked too. A finding is printed
#      as <blob id>/<path>: `git log --all --oneline --find-object=<blob id>` names the commits.
#   3. Ansible Vault files must be encrypted
#
# Every check runs, then the push is refused if any failed. A missing python3 or gitleaks
# refuses the push too. A secret that is already in a commit has to leave the commit (rewrite
# it before pushing) and be rotated if it ever left this machine. `git push --no-verify` skips
# this hook; the repository is public, so do not use it without the owner's approval.
#
# Limits: gitleaks opens .zip, .tar, .gz, .bz2 and .xz files by their extension, and skips a
# file that starts with the signature of an archive or of a PDF, whatever its name. Neither check
# looks inside other compressed files (.tgz, Office documents, 7z, rar). A remote that was
# deleted and recreated empty leaves stale remote-tracking branches here, and a push of a new
# branch does not check the commits they reach (they were public before).
set -eu

remote=${1:-origin}
hooks_dir=$(cd "$(dirname "$0")" && pwd)
. "$hooks_dir/lib.sh"
root=$(git rev-parse --show-toplevel)
cd "$root"
status=0
export_dir=

is_zero() {
  case $1 in
    '' | *[!0]*) return 1 ;;
    *) return 0 ;;
  esac
}

# gitleaks on a text file. $1 = the file, $2 = what it holds, for the message.
scan_gitleaks_text() {
  _rc=0
  if [ -n "$config" ]; then
    "$gitleaks" stdin --redact --verbose --no-banner --no-color --log-level warn \
      --config "$config" <"$1" || _rc=$?
  else
    "$gitleaks" stdin --redact --verbose --no-banner --no-color --log-level warn <"$1" || _rc=$?
  fi
  if [ "$_rc" -ne 0 ]; then
    echo "pre-push: gitleaks found a secret in $2 (exit $_rc)." >&2
    return 1
  fi
}

# A text file against the .env values (secret-guard) and gitleaks. $1 = the file, $2 = what it holds.
scan_text() {
  _bad=0
  if [ -n "$python" ]; then
    "$python" -I "$hooks_dir/secret-guard.py" --message "$1" </dev/null || _bad=1
  fi
  if [ -n "$gitleaks" ]; then
    scan_gitleaks_text "$1" "$2" || _bad=1
  fi
  return "$_bad"
}

python=$(find_python) || python=
if [ -z "$python" ]; then
  echo "pre-push: python3 not found, so the commits cannot be checked." >&2
  status=1
fi
gitleaks=$(find_gitleaks) || gitleaks=
if [ -z "$gitleaks" ]; then
  echo "pre-push: gitleaks not found, so the commits cannot be scanned." >&2
  echo "Install it (macOS: brew install gitleaks), or point GITLEAKS_BIN at the binary." >&2
  status=1
fi
config=$(find_gitleaks_config "$root" "$hooks_dir") || config=
vault_check="$root/ansible/scripts/check-vault-encrypted.sh"
tmp=$(mktemp "${TMPDIR:-/tmp}/pre-push.XXXXXX")
trap 'rm -f "$tmp"; if [ -n "$export_dir" ]; then rm -rf "$export_dir"; fi' EXIT

# One line per ref to push: <local ref> <local oid> <remote ref> <remote oid>
while read -r local_ref local_oid remote_ref remote_oid; do
  if is_zero "$local_oid"; then
    continue # deleting a remote ref sends nothing
  fi
  # The commits to send: not on the remote when it is known here, else not on any
  # remote-tracking branch of it.
  known=0
  if ! is_zero "$remote_oid" && git cat-file -e "$remote_oid^{commit}" 2>/dev/null; then
    known=1
    set -- "$local_oid" --not "$remote_oid"
  else
    set -- "$local_oid" --not "--remotes=$remote"
  fi
  failed=0

  if [ -n "$export_dir" ]; then
    rm -rf "$export_dir"
    export_dir=
  fi
  if [ -n "$python" ]; then
    if [ -n "$gitleaks" ]; then
      export_dir=$(mktemp -d "${TMPDIR:-/tmp}/pre-push.XXXXXX")
    fi
    run_secret_guard --range "$@" </dev/null || failed=1
  fi

  # An annotated tag has a message that no commit carries.
  if [ "$(git cat-file -t "$local_oid" 2>/dev/null </dev/null || true)" = tag ]; then
    if git cat-file tag "$local_oid" >"$tmp" 2>/dev/null </dev/null; then
      scan_text "$tmp" "the message of the tag" || failed=1
    else
      echo "pre-push: cannot read the tag." >&2
      failed=1
    fi
  fi

  if [ -n "$export_dir" ] && export_has_files "$export_dir"; then
    rc=0
    gitleaks_scan_dir "$export_dir" </dev/null || rc=$?
    if [ "$rc" -ne 0 ]; then
      echo "pre-push: gitleaks reported a problem (exit $rc)." >&2
      failed=1
    fi
  fi
  if [ -n "$gitleaks" ]; then
    # gitleaks reads files, not the messages of the commits: feed it those too
    if git log --format=%B "$@" >"$tmp" 2>/dev/null </dev/null; then
      scan_gitleaks_text "$tmp" "a commit message" || failed=1
    else
      echo "pre-push: cannot read the commit messages." >&2
      failed=1
    fi
  fi

  if [ -f "$vault_check" ]; then
    if [ "$known" -eq 1 ]; then
      bash "$vault_check" --range "$remote_oid..$local_oid" >/dev/null </dev/null || failed=1
    else
      for commit in $(git rev-list "$@" </dev/null); do
        bash "$vault_check" --range "$commit^!" >/dev/null </dev/null || failed=1
      done
    fi
  fi

  if [ "$failed" -ne 0 ]; then
    echo "pre-push: $local_ref carries a secret or an unencrypted vault: not pushed." >&2
    echo "Remove it from the commits (rewrite them), and rotate it if it ever left this machine." >&2
    echo "False positive: add 'gitleaks:allow' in a comment on the line, or the finding's Fingerprint" >&2
    echo "to .gitleaksignore (it names the blob, so it stays valid)." >&2
    status=1
  fi
done

if [ "$status" -ne 0 ]; then
  echo "pre-push: push refused." >&2
fi
exit "$status"
