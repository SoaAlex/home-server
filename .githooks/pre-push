#!/bin/sh
# pre-push: refuse to push commits that carry a secret.
#
# pre-commit and commit-msg only see the commits made here with the hooks on. A merge, a
# rebase, a cherry-pick, `git am` and `git commit --no-verify` skip them, so this is the last
# gate before the commits become public. It runs the pre-commit checks on everything the push
# would send, i.e. the commits the remote does not have yet:
#
#   1. secret-guard.py --range: file names, .env values, commit messages and the names and
#      addresses of the author and the committer. It also copies every file the commits add
#      or change (each version of it, under the id of its blob) into a temporary directory,
#      with a second copy of those gitleaks would skip by name or by what they begin with or
#      hold at a fixed place, or cannot read (see pre-commit).
#   2. gitleaks over that directory, and over the commit messages and identities, configured
#      by .gitleaks.toml; the message of an annotated tag, and of the tags it points to, is
#      checked too. A finding is printed as <blob id>/<path>: `git log --all --oneline
#      --find-object=<blob id>` names the commits.
#   3. Ansible Vault files must be encrypted
#
# Every check runs, then the push is refused if any failed. A missing python3 or gitleaks
# refuses the push too. A secret that is already in a commit has to leave the commit (rewrite
# it before pushing) and be rotated if it ever left this machine. `git push --no-verify` skips
# this hook; the repository is public, so do not use it without the owner's approval.
#
# Limits: gitleaks opens .zip, .tar, .gz, .bz2 and .xz files by their extension, down to 3 levels
# (deeper ones are skipped with a warning). Neither check looks inside other compressed files (.tgz,
# Office documents, 7z, rar): a secret there is not found. Files over 64 MB are not copied for
# gitleaks (the .env values are still checked, and the file is announced). A remote that was
# deleted and recreated empty leaves stale remote-tracking branches here, and a push of a new
# branch does not check the commits they reach (they were public before). The mergetag and
# gpgsig headers of a commit are not scanned. README.md, "What the hooks cannot see", lists
# them all.
set -eu

remote=${1:-origin}
hooks_dir=$(cd "$(dirname "$0")" && pwd)
. "$hooks_dir/lib.sh"
root=$(git rev-parse --show-toplevel)
cd "$root"
status=0
export_dir=

is_zero() {
  case $1 in
    '' | *[!0]*) return 1 ;;
    *) return 0 ;;
  esac
}

# gitleaks on a text file. $1 = the file, $2 = what it holds, for the message.
scan_gitleaks_text() {
  _rc=0
  if [ -n "$config" ]; then
    gitleaks_pad <"$1" | "$gitleaks" stdin --redact --verbose --no-banner --no-color --log-level warn \
      --config "$config" || _rc=$?
  else
    gitleaks_pad <"$1" | "$gitleaks" stdin --redact --verbose --no-banner --no-color --log-level warn || _rc=$?
  fi
  if [ "$_rc" -ne 0 ]; then
    echo "pre-push: gitleaks found a secret in $2 (exit $_rc)." >&2
    return 1
  fi
}

# A text file against the .env values (secret-guard) and gitleaks. $1 = the file, $2 = what it holds.
scan_text() {
  _bad=0
  if [ -n "$python" ]; then
    "$python" -I "$hooks_dir/secret-guard.py" --message "$1" </dev/null || _bad=1
  fi
  if [ -n "$gitleaks" ]; then
    scan_gitleaks_text "$1" "$2" || _bad=1
  fi
  return "$_bad"
}

python=$(find_python) || python=
if [ -z "$python" ]; then
  echo "pre-push: python3 not found, so the commits cannot be checked." >&2
  status=1
fi
gitleaks=$(find_gitleaks) || gitleaks=
if [ -z "$gitleaks" ]; then
  echo "pre-push: gitleaks not found, so the commits cannot be scanned." >&2
  echo "Install it (macOS: brew install gitleaks), or point GITLEAKS_BIN at the binary." >&2
  status=1
fi
config=$(find_gitleaks_config "$root" "$hooks_dir") || config=
if [ -n "$gitleaks" ] && ! gitleaks_selftest; then
  echo "pre-push: gitleaks does not report a token it is given: it cannot be trusted with the commits." >&2
  status=1
fi
vault_check="$root/ansible/scripts/check-vault-encrypted.sh"
tmp=$(mktemp "${TMPDIR:-/tmp}/pre-push.XXXXXX")
trap 'rm -f "$tmp"; if [ -n "$export_dir" ]; then rm -rf "$export_dir"; fi' EXIT
exit_on_signals

# One line per ref to push: <local ref> <local oid> <remote ref> <remote oid>
while read -r local_ref local_oid remote_ref remote_oid; do
  if is_zero "$local_oid"; then
    continue # deleting a remote ref sends nothing
  fi
  # The commits to send: not on the remote when it is known here, else not on any
  # remote-tracking branch of it.
  known=0
  if ! is_zero "$remote_oid" && git cat-file -e "$remote_oid^{commit}" 2>/dev/null; then
    known=1
    set -- "$local_oid" --not "$remote_oid"
  else
    set -- "$local_oid" --not "--remotes=$remote"
  fi
  failed=0
  broken=0

  if [ -n "$export_dir" ]; then
    rm -rf "$export_dir"
    export_dir=
  fi
  if [ -n "$python" ]; then
    if [ -n "$gitleaks" ]; then
      export_dir=$(mktemp -d "${TMPDIR:-/tmp}/pre-push.XXXXXX")
    fi
    guard_rc=0
    run_secret_guard --range "$@" </dev/null || guard_rc=$?
    if [ "$guard_rc" -ne 0 ]; then
      failed=1
    fi
    if [ "$guard_rc" -ge 2 ]; then
      broken=1 # the check itself failed: it found nothing wrong, it could not look
    fi
  fi

  # An annotated tag has a message that no commit carries, and a tag can point to another tag: scan them all.
  tag_oid=$local_oid
  tag_depth=0
  while [ "$(git cat-file -t "$tag_oid" 2>/dev/null </dev/null || true)" = tag ]; do
    tag_depth=$((tag_depth + 1))
    if [ "$tag_depth" -gt 20 ]; then
      echo "pre-push: $local_ref is a chain of more than 20 tags: not checked." >&2
      failed=1
      broken=1
      break
    fi
    if git cat-file tag "$tag_oid" >"$tmp" 2>/dev/null </dev/null; then
      scan_text "$tmp" "the message of a tag" || failed=1
      tag_oid=$(sed -n '1s/^object //p' "$tmp")
    else
      echo "pre-push: cannot read the tag." >&2
      failed=1
      broken=1
      break
    fi
  done

  if [ -n "$export_dir" ] && export_has_files "$export_dir"; then
    rc=0
    gitleaks_scan_dir "$export_dir" </dev/null || rc=$?
    if [ "$rc" -ne 0 ]; then
      echo "pre-push: gitleaks reported a problem (exit $rc)." >&2
      failed=1
      if [ "$rc" -ne 1 ]; then
        broken=1 # exit 1 is "leaks found"; anything else is gitleaks failing
      fi
    fi
  fi
  if [ -n "$gitleaks" ]; then
    # gitleaks reads files, not the messages of the commits: feed it those too
    if git log --format='%an%n%ae%n%cn%n%ce%n%B' "$@" >"$tmp" 2>/dev/null </dev/null; then
      scan_gitleaks_text "$tmp" "a commit message or the name of its author" || failed=1
    else
      echo "pre-push: cannot read the commit messages." >&2
      failed=1
    fi
  fi

  if [ -f "$vault_check" ]; then
    if [ "$known" -eq 1 ]; then
      bash "$vault_check" --range "$remote_oid..$local_oid" >/dev/null </dev/null || failed=1
    else
      for commit in $(git rev-list "$@" </dev/null); do
        bash "$vault_check" --range "$commit^!" >/dev/null </dev/null || failed=1
      done
    fi
  fi

  if [ "$failed" -ne 0 ]; then
    if [ "$broken" -ne 0 ]; then
      echo "pre-push: a check could not run for $local_ref (see above), so it was not checked: not pushed." >&2
    else
      echo "pre-push: $local_ref carries a secret or an unencrypted vault: not pushed." >&2
    fi
    echo "Remove it from the commits (rewrite them), and rotate it if it ever left this machine." >&2
    echo "False positive: add 'gitleaks:allow' in a comment on the line, or the finding's Fingerprint" >&2
    echo "to .gitleaksignore (it names the blob, so it stays valid)." >&2
    status=1
  fi
done

if [ "$status" -ne 0 ]; then
  echo "pre-push: push refused." >&2
fi
exit "$status"
