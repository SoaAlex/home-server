# Template for home-server/.env (git-ignored). Copy it to .env and fill in every value.
# Variables used by docker-compose.yaml.

# Pi-hole
PIHOLE_WEBPASSWORD=change-me
# Frigate (RTSP password of the cameras)
FRIGATE_RTSP_PASSWORD=change-me
# VS Code server
# PTZ preset service (Home Assistant -> ONVIF AbsoluteMove)
PTZ_API_TOKEN=change-me
PTZ_CAMERA_USER=change-me
# wstunnel: secret HTTP upgrade path prefix (WireGuard over WSS). Random and URL-safe,
# e.g. `openssl rand -hex 16`. Also needed on the Mac client, see wstunnel/README.md.
WSTUNNEL_PATH_PREFIX=change-me
