# Settings of the wstunnel client (wstunnel-vpn.sh). Copy to wstunnel.env, next to the
# scripts, and fill it in. wstunnel.env is git-ignored: never commit the real file.
# On the NAS, `sh home-server/wstunnel/make-kit.sh` writes it for you.

# Required: same value as WSTUNNEL_PATH_PREFIX in home-server/.env on the NAS (a secret).
WSTUNNEL_PATH_PREFIX=change-me

# Optional:
# WSTUNNEL_URL=wss://vpn.soaalex.com:443
# WSTUNNEL_LOG_LVL=WARN
# HTTP_PROXY=http://proxy.example:8080
