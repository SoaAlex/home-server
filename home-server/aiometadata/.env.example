# AIOMetadata (read by compose as env_file). Upstream documents more
# optional variables: https://github.com/cedya77/aiometadata
PORT=3232
HOST_NAME=https://aiometadata.example.com
NODE_ENV=production
LOG_LEVEL=info
DATABASE_URI=postgres://aiometadata:change-me@common-postgres:5432/aiometadata
REDIS_URL=redis://common-redis:6379
ADMIN_KEY=change-me
